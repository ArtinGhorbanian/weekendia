# Weekendia configuration example
#
# Copy this file to .env for local development. Process-level environment
# variables take precedence over values in .env. Never commit a real API key.

# "demo" generates deterministic local sample plans and sends no plan data to
# an external model provider. Change to "openai" only after configuring the
# provider settings below and reviewing the data-handling implications.
WEEKENDIA_MODE=demo

# Required only when WEEKENDIA_MODE=openai.
OPENAI_API_KEY=your_api_key_here
OPENAI_MODEL=

# OpenAI-compatible API endpoint. HTTPS is required except for localhost.
OPENAI_BASE_URL=https://api.openai.com/v1

# Optional HTTP, HTTPS, SOCKS5, or SOCKS5H proxy. Embedded credentials are
# rejected; authenticated proxy URLs are not supported by this setting.
OPENAI_PROXY_URL=

# Maximum provider response size. Values are bounded to 1-4096 tokens.
# OPENAI_MAX_OUTPUT_TOKENS is accepted as a legacy fallback only when the
# preferred WEEKENDIA_MAX_OUTPUT_TOKENS variable is absent.
WEEKENDIA_MAX_OUTPUT_TOKENS=1800

# Per-process request controls. These are defensive local limits, not a
# substitute for shared infrastructure controls in a multi-instance deployment.
WEEKENDIA_RATE_LIMIT_REQUESTS=12
WEEKENDIA_RATE_LIMIT_WINDOW_SECONDS=60
WEEKENDIA_MAX_CONCURRENT_PLANS=4

# Local Flask development server. Keep debug disabled; the built-in server and
# debugger are not intended for production deployment.
FLASK_HOST=127.0.0.1
FLASK_PORT=5000
FLASK_DEBUG=false
